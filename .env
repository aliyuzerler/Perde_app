# PerdeGo — kök ortam değişkenleri (referans).
#
# Not: Uygulamalar kendi .env dosyalarını kullanır (apps/api/.env,
# apps/admin/.env.local, apps/mobile/.env). Buradaki değer yalnızca
# cwd'de .env bulamayan araçların (örn. @prisma/client iç dotenv'i
# yukarı doğru ararsa) SQLite scaffold artığıyla zehirlenmemesi içindir.
# Varsayılan: docker-compose.yml / scripts/qa-pg ile aynı bağlantı.
DATABASE_URL=postgresql://perdego:perdego_dev_pass@localhost:5432/perdego?schema=public

# ============================================================
# PerdeGo - Ornek Cevre Degiskenleri (.env.example)
# GERCEK SIRLARI BU DOSYAYA VE GIT DEPOSUNA YAZMAYINIZ (Kural 7)
# Her uygulama kendi dizinindeki .env dosyasindan okur.
# ============================================================

# ---------- apps/mobile (Expo / React Native) ----------
# Expo'da istemci tarafindan gorunur degiskenler EXPO_PUBLIC_ oneki kullanir.
# Bu degerler uygulama paketine gomulur; sifreli bir ifade tasimayin.
# Faz 1-2 arasi gelistirme: mock adapter devreye girer.
EXPO_PUBLIC_MOCK_API=1
# Faz 2'de gercek API devreye alindiginda mock kapatilir (EXPO_PUBLIC_MOCK_API=0).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# ---------- apps/api (NestJS) - Faz 2'de kullanilacak ----------
NODE_ENV=development
PORT=3000
# PostgreSQL baglanti dizesi - gercek degerler sadece yerel .env dosyasinda
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/perdego?schema=public
# Redis (opsiyonel - onbellek ve gorev kuyrugu icin, Faz 2+)
REDIS_URL=redis://localhost:6379
# JWT - gercek degerleri asla depoya yazmayin (Faz 3)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---------- apps/admin (Next.js) - Faz 6'da kullanilacak ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# ---------- Video yayin saglayicisi (Faz 4'te kullanilacak) ----------
# HLS paketleme/CDN saglayicisi secildiginde doldurulacak (orn. Mux / Cloudflare Stream / AWS MediaConvert+CloudFront).
VIDEO_PROVIDER_API_KEY=CHANGE_ME
VIDEO_SIGNING_KEY_ID=CHANGE_ME
VIDEO_SIGNING_PRIVATE_KEY=CHANGE_ME

# ---------- Odeme (Faz 5'te kullanilacak) ----------
# RevenueCat: API anahtari sunucu tarafinda tutulur; istemci public SDK anahtari kullanir.
REVENUECAT_SECRET_API_KEY=CHANGE_ME
EXPO_PUBLIC_REVENUECAT_PUBLIC_SDK_KEY=CHANGE_ME

# ============================================================
# PerdeGo - Kök Ornek Cevre Degiskenleri (master referans)
# GERCEK SIRLARI DEPOYA YAZMAYINIZ (Genel Kural 7).
#
# Her uygulama KENDI dizinindeki .env dosyasindan okur:
#   apps/mobile/.env.example   → apps/mobile/.env
#   apps/api/.env.example      → apps/api/.env
#   apps/admin/.env.example    → apps/admin/.env.local
#
# Bu kök dosya; docker-compose.yml değişkenleri ve genel referanstır.
# ============================================================

# ---------- Docker Compose (PostgreSQL + Redis) ----------
POSTGRES_USER=perdego
POSTGRES_PASSWORD=perdego_dev_pass
POSTGRES_DB=perdego
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- apps/api (NestJS) — ayrıntı için apps/api/.env.example ----------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://perdego:perdego_dev_pass@localhost:5432/perdego?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:19006,http://localhost:3001

# ---------- apps/mobile (Expo) — ayrıntı için apps/mobile/.env.example ----------
EXPO_PUBLIC_MOCK_API=1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ---------- apps/admin (Next.js) — ayrıntı için apps/admin/.env.example ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ---------- Video yayın sağlayıcısı (Faz 4'te kullanılacak) ----------
# HLS paketleme/CDN sağlayıcısı seçildiğinde doldurulacak (bkz. docs/ARCHITECTURE.md §6):
# BUNNY_LIBRARY_ID, BUNNY_API_KEY, BUNNY_TOKEN_SIGNING_KEY vb.
VIDEO_PROVIDER_API_KEY=CHANGE_ME
VIDEO_SIGNING_KEY_ID=CHANGE_ME
VIDEO_SIGNING_PRIVATE_KEY=CHANGE_ME

# ---------- Ödeme (Faz 5'te kullanılacak) ----------
# RevenueCat: API anahtarı sunucu tarafında tutulur; istemci public SDK anahtarı kullanır.
REVENUECAT_SECRET_API_KEY=CHANGE_ME
EXPO_PUBLIC_REVENUECAT_PUBLIC_SDK_KEY=CHANGE_ME

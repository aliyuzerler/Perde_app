# ============================================================
# PerdeGo API - Ornek Cevre Degiskenleri (apps/api/.env.example)
# GERCEK SIRLARI DEPOYA YAZMAYINIZ (Genel Kural 7).
# Kullanim: cp .env.example .env  → sonra .env dosyasinda duzenleyin.
# ============================================================

# Uygulama modu: development | test | production
NODE_ENV=development

# HTTP dinleme portu
PORT=3000

# PostgreSQL baglantisi (docker compose ile: pnpm db:up)
# Sifreyi docker-compose.yml ile ayni tutun (varsayilan: perdego_dev_pass).
DATABASE_URL=postgresql://perdego:perdego_dev_pass@localhost:5432/perdego?schema=public

# Redis (opsiyonel - kuyruk/onbellek fazlarinda kullanilacak; bos birakilabilir)
REDIS_URL=redis://localhost:6379

# CORS izinli kokler (virgulle ayrilmis; bos = kapali)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3001

# --- Faz 3b: e-posta (Mailpit) ------------------------------------------------
# Mailpit yerel test SMTP'si (docker compose'da yoksa brew/mailpit binary):
# SMTP_HOST tanımlı değilse geliştirme transport'u e-postaları
# MAIL_OUTBOX_FILE dosyasına JSONL olarak yazar (Mailpit kurulumu zorunlu degil).
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=PerdeGo <no-reply@perdego.local>
MAIL_OUTBOX_FILE=.mail-outbox.jsonl

# --- Faz 3b: anahtar omru, silme nefalleti, rate limit ------------------------
VERIFY_EMAIL_TTL_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=30
DELETION_GRACE_DAYS=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_REGISTER_MAX=3
AUTH_RATE_LIMIT_RESET_MAX=3

# --- Faz 3b: avatar yukleme ----------------------------------------------------
# Goreli yol API calisma dizinine gore cozulur; mutlak yol da verilabilir.
UPLOAD_DIR=uploads

# --- FAZ 4: medya saglayici (video akisi) ---------------------------------------
# Yalnizca LOCAL bu depoda uygulanmistir; bunny|mux|cloudflare icin
# docs/MEDIA_SETUP.md belgesine bakin. PRODUCTION'da local secilemez.
MEDIA_PROVIDER=local
# Saglayiciya dogrudan yukleme URL'inin gecerlilik suresi (saniye).
MEDIA_UPLOAD_TTL_SECONDS=900
# Gelistirme saglayicisinin dosya deposu (ornek paketler + yuklemeler).
MEDIA_STORAGE_DIR=media-storage
# Tek yukleme dosyasi icin ust sinir (MB).
MEDIA_MAX_UPLOAD_MB=512
# Gelistirme: PROCESSING -> READY gecisi icin sahte gecikme (ms). Testlerde 0.
MEDIA_PROCESSING_DELAY_MS=1500

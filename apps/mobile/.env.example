# ============================================================
# PerdeGo Mobil - Ornek Cevre Degiskenleri (apps/mobile/.env.example)
# GERCEK SIRLARI DEPOYA YAZMAYINIZ (Genel Kural 7).
# Kullanim: cp .env.example .env  → sonra duzenleyin.
# NOT: EXPO_PUBLIC_ onekli degerler uygulama paketine gomulur; sifre yazmayin.
# ============================================================

# Faz 1-2 arasi gelistirme: mock adapter devrede (yalnizca __DEV__ iken).
# Gercek API'ye gecis: EXPO_PUBLIC_MOCK_API=0
EXPO_PUBLIC_MOCK_API=1

# Gercek API taban adresi (apps/api varsayilan portu 3000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Faz 5'te kullanilacak (RevenueCat public SDK anahti - gizli DEGIL)
# EXPO_PUBLIC_REVENUECAT_PUBLIC_SDK_KEY=

# --- FAZ 7: ödeme (RevenueCat) -------------------------------------------------
# Not: RC public SDK anahtarı sunucudan /billing/config ucuyla da gelir
# (ortam başına ayrıştırma sunucu yapılandırmasındadır). Bu değişken yalnızca
# sunucu yapılandırması olmadan da SDK kurulumunun denenmesi istenirse kullanılır.
# Public anahtardır; gizli anahtar YAZMAYIN.
# EXPO_PUBLIC_REVENUECAT_PUBLIC_SDK_KEY=

{
  "name": "perdego",
  "version": "0.2.0",
  "private": true,
  "description": "PerdeGo - dikey kisa film ve mini dizi izleme platformu (pnpm monorepo)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @perdego/mobile run dev",
    "dev:api": "pnpm --filter @perdego/api run dev",
    "dev:admin": "pnpm --filter @perdego/admin run dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres redis",
    "db:migrate": "pnpm --filter @perdego/api run db:migrate",
    "db:deploy": "pnpm --filter @perdego/api run db:deploy",
    "db:seed": "pnpm --filter @perdego/api run db:seed",
    "db:studio": "pnpm --filter @perdego/api run db:studio",
    "build": "pnpm -r --if-present run build"
  }
}
